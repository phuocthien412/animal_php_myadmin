# ============================================================
# NEKOPARA — Environment Configuration Example
# Sao chép file này thành .env và điền giá trị phù hợp
# cp .env.example .env
# ============================================================

# BASE_URL: Đường dẫn gốc của project (không có / ở cuối)
#
# Laragon chạy thư mục con:
#   BASE_URL=/animal_php_myadmin/animal_php_myadmin
#
# Laragon virtual host (vd: nekopara.test):
#   BASE_URL=
#
# XAMPP:
#   BASE_URL=/animal_php_myadmin/animal_php_myadmin
#
# Production (domain riêng):
#   BASE_URL=

BASE_URL=/animal_php_myadmin/animal_php_myadmin
